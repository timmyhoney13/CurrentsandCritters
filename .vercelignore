# Start from ignore-all so deploy upload stays small and intentional.
*

# Vercel config files.
!.vercelignore
!vercel.json

# Root landing page.
!index.html

# Multiplayer web client.
!multiplayer/
!multiplayer/client/
!multiplayer/client/**

# Card image slices used by the web UI.
!horizontal_cards/
!horizontal_cards/**
!vertical_cards/
!vertical_cards/**
!oceans_cards/
!oceans_cards/**
