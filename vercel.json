{
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" }
      ]
    },
    {
      "source": "/firebase-config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(horizontal_cards|vertical_cards|oceans_cards)/(.*)\\.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/leaderboard-bg.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/game",              "destination": "https://play.currentsandcritters.com/", "permanent": false },
    { "source": "/admin/newsletter",  "destination": "https://play.currentsandcritters.com/admin/newsletter", "permanent": false },
    { "source": "/newsletter/unsubscribe/:token", "destination": "https://play.currentsandcritters.com/newsletter/unsubscribe/:token", "permanent": false },
    { "source": "/play/:room_id",     "destination": "https://play.currentsandcritters.com/play/:room_id", "permanent": false },
    { "source": "/preview",           "destination": "https://play.currentsandcritters.com/", "permanent": false },
    { "source": "/preview/:room_id",  "destination": "https://play.currentsandcritters.com/play/:room_id", "permanent": false }
  ],
  "rewrites": [
    { "source": "/classic",              "destination": "/multiplayer/client/index.html" },
    { "source": "/classic/:room_id",     "destination": "/multiplayer/client/index.html" },
    { "source": "/old",                  "destination": "/multiplayer/client/index.html" },
    { "source": "/old/:room_id",         "destination": "/multiplayer/client/index.html" },
    { "source": "/rules",                "destination": "/multiplayer/client/rules.html" },
    { "source": "/privacy",              "destination": "/multiplayer/client/privacy.html" },
    { "source": "/privacy-policy",       "destination": "/multiplayer/client/privacy.html" },
    { "source": "/about",                "destination": "/multiplayer/client/about.html" },
    { "source": "/leaderboard",          "destination": "/multiplayer/client/leaderboard.html" },
    { "source": "/leaderboard-bg.jpg",  "destination": "/multiplayer/client/leaderboard-bg.jpg" },
    { "source": "/email-logo.png",      "destination": "/multiplayer/client/email-logo.png" },
    { "source": "/sw.js",               "destination": "/multiplayer/client/sw.js" },
    { "source": "/icon.svg",             "destination": "/multiplayer/client/icon.svg" },
    { "source": "/manifest.webmanifest", "destination": "/multiplayer/client/manifest.webmanifest" },
    { "source": "/css/:file",     "destination": "/multiplayer/client/css/:file" },
    { "source": "/js/:file",      "destination": "/multiplayer/client/js/:file" },
    { "source": "/avatars/:file", "destination": "/multiplayer/client/avatars/:file" },
    { "source": "/species/:file", "destination": "/multiplayer/client/species/:file" }
  ]
}
